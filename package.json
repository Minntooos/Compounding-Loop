{
  "name": "compounding-loop",
  "version": "0.0.0",
  "description": "Write the brief, check back tomorrow: unattended, verified Claude Code build loops with a local dashboard.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "loop": "bin/loop.js"
  },
  "files": [
    "bin/",
    "dist/",
    "templates/",
    "method/",
    "runners/",
    "plugin/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Minntooos/compounding-loop.git"
  },
  "keywords": [
    "claude-code",
    "ai-agents",
    "autonomous",
    "dashboard",
    "cli",
    "context-engineering"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "unit": "vitest run",
    "build": "tsc -p tsconfig.build.json && vite build",
    "e2e": "playwright test",
    "test": "npm run check && npm run typecheck && npm run unit && npm run build && npm run e2e",
    "dev:web": "vite",
    "preview": "vite preview --port 4173 --strictPort"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@hono/node-server": "^2.1.4",
    "commander": "^15.0.0",
    "hono": "^4.13.13"
  }
}
